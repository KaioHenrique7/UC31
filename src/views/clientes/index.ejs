<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <title>Veículos</title>
</head>

<body>

<h1>Veículos cadastrados</h1>

<a href="/veiculos/cadastrar">
Novo veículo
</a>

<hr>

<% veiculos.forEach(veiculo => { %>

<p>
Modelo: <%= veiculo.modelo %><br>
Placa: <%= veiculo.placa %><br>
</p>

<hr>

<% }) %>


<a href="/">
Voltar
</a>

</body>
</html>