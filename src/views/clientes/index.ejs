<!DOCTYPE html>
<html lang="pt-BR">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Clientes</title>

    <link
        rel="stylesheet"
        href="/css/style.css"
    >

</head>

<body>

<header>

    <h1> Clientes</h1>

    <p>Clientes cadastrados na oficina</p>

</header>


<main class="container">

    <div class="card">

        <div class="botoes">

            <a
                href="/"
                class="btn btn-secondary"
            >
                ← Início
            </a>

            <a
                href="/clientes/cadastrar"
                class="btn btn-primary"
            >
                 Novo Cliente
            </a>

        </div>

        <br>


        <% if (clientes.length === 0) { %>

            <p>
                Nenhum cliente cadastrado.
            </p>

        <% } else { %>


            <% clientes.forEach(cliente => { %>

                <div class="detalhe">

                    <strong>Nome</strong>

                    <span>
                        <%= cliente.nome %>
                    </span>


                    <br>


                    <strong>Telefone</strong>

                    <span>
                        <%= cliente.telefone %>
                    </span>


                    <br>


                    <strong>Email</strong>

                    <span>
                        <%= cliente.email %>
                    </span>


                    <div class="botoes">

                        <a
                            href="/clientes/<%= cliente.id %>"
                            class="btn btn-primary"
                        >
                             Detalhes
                        </a>


                        <a
                            href="/clientes/<%= cliente.id %>/editar"
                            class="btn btn-warning"
                        >
                             Editar
                        </a>


                        <form
                            action="/clientes/<%= cliente.id %>?_method=DELETE"
                            method="POST"
                            style="display: inline;"
                            onsubmit="return confirm('Tem certeza que deseja excluir este cliente?');"
                        >

                            <button
                                type="submit"
                                class="btn btn-danger"
                            >
                                Excluir
                            </button>

                        </form>

                    </div>

                </div>

            <% }) %>


        <% } %>

    </div>

</main>

</body>

</html>