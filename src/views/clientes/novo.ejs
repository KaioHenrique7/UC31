<!DOCTYPE html>
<html lang="pt-BR">

<head>

<meta charset="UTF-8">
<title>Novo Cliente</title>

<link rel="stylesheet" href="/css/style.css">

</head>


<body>


<h1>Cadastrar Cliente</h1>


<form action="/clientes" method="POST">


<label>Nome:</label>

<input 
type="text" 
name="nome"
required>


<label>Telefone:</label>

<input 
type="text" 
name="telefone"
required>


<label>Email:</label>

<input 
type="email" 
name="email"
required>


<button type="submit">
Salvar
</button>


</form>


<a href="/clientes">
Voltar
</a>


</body>

</html>