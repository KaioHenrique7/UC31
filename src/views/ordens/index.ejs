<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Ordens de Serviço - Oficina</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f4f6f9;
            color: #222;
        }

        header {
            background: #1769e0;
            color: white;
            padding: 25px;
            text-align: center;
        }

        header h1 {
            margin: 0 0 8px;
        }

        header p {
            margin: 0;
        }

        .container {
            width: 90%;
            max-width: 1100px;
            margin: 35px auto;
        }

        .topo {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 25px;
            gap: 15px;
        }

        .topo h2 {
            margin: 0;
        }

        .botoes {
            display: flex;
            gap: 10px;
        }

        .btn {
            display: inline-block;
            padding: 11px 18px;
            border-radius: 8px;
            text-decoration: none;
            border: none;
            cursor: pointer;
            font-size: 15px;
        }

        .btn-principal {
            background: #1769e0;
            color: white;
        }

        .btn-principal:hover {
            background: #0d55bd;
        }

        .btn-voltar {
            background: #555;
            color: white;
        }

        .btn-detalhes {
            background: #17a2b8;
            color: white;
        }

        .btn-editar {
            background: #f0ad00;
            color: white;
        }

        .tabela-container {
            background: white;
            border-radius: 12px;
            box-shadow: 0 3px 12px rgba(0, 0, 0, 0.08);
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th {
            background: #1769e0;
            color: white;
            padding: 15px;
            text-align: left;
        }

        td {
            padding: 15px;
            border-bottom: 1px solid #eee;
        }

        tr:hover {
            background: #f7f9fc;
        }

        .acoes {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }

        .status {
            display: inline-block;
            padding: 6px 12px;
            border-radius: 20px;
            background: #e8f1ff;
            color: #1769e0;
            font-weight: bold;
            font-size: 13px;
        }

        .vazio {
            text-align: center;
            padding: 50px 20px;
            color: #777;
        }

        .vazio h3 {
            color: #333;
        }

        footer {
            text-align: center;
            padding: 30px;
            color: #777;
        }

        @media (max-width: 700px) {
            .topo {
                flex-direction: column;
                align-items: flex-start;
            }

            .botoes {
                width: 100%;
                flex-direction: column;
            }

            .botoes .btn {
                text-align: center;
            }
        }
    </style>
</head>

<body>

<header>
    <h1>🔧 Sistema da Oficina</h1>
    <p>Gerenciamento de ordens de serviço</p>
</header>

<main class="container">

    <div class="topo">

        <h2>Ordens de Serviço</h2>

        <div class="botoes">

            <a href="/" class="btn btn-voltar">
                ← Início
            </a>

            <a href="/ordens/cadastrar" class="btn btn-principal">
                + Nova ordem
            </a>

        </div>

    </div>

    <% if (ordens.length === 0) { %>

        <div class="tabela-container">

            <div class="vazio">

                <h3>🔧 Nenhuma ordem cadastrada</h3>

                <p>Comece cadastrando uma nova ordem de serviço.</p>

                <a href="/ordens/cadastrar" class="btn btn-principal">
                    Criar ordem
                </a>

            </div>

        </div>

    <% } else { %>

        <div class="tabela-container">

            <table>

                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Descrição</th>
                        <th>Status</th>
                        <th>Ações</th>
                    </tr>
                </thead>

                <tbody>

                    <% ordens.forEach(ordem => { %>

                        <tr>

                            <td>
                                <strong><%= ordem.id %></strong>
                            </td>

                            <td>
                                <%= ordem.descricao || "Sem descrição" %>
                            </td>

                            <td>
                                <span class="status">
                                    <%= ordem.status || "Pendente" %>
                                </span>
                            </td>

                            <td>

                                <div class="acoes">

                                    <a
                                        href="/ordens/<%= ordem.id %>"
                                        class="btn btn-detalhes">
                                        Detalhes
                                    </a>

                                    <a
                                        href="/ordens/<%= ordem.id %>/editar"
                                        class="btn btn-editar">
                                        Editar
                                    </a>

                                </div>

                            </td>

                        </tr>

                    <% }) %>

                </tbody>

            </table>

        </div>

    <% } %>

</main>

<footer>
    Sistema de gerenciamento de oficina
</footer>

</body>
</html>