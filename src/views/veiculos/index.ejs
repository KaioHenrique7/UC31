<!DOCTYPE html>
<html lang="pt-BR">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Veículos</title>

    <link
        rel="stylesheet"
        href="/css/style.css"
    >

</head>

<body>

<header>

    <h1> Veículos</h1>

    <p>Veículos cadastrados na oficina</p>

</header>


<main class="container">

    <div class="card">

        <div class="botoes">

            <a
                href="/"
                class="btn btn-secondary"
            >
                ← Início
            </a>

            <a
                href="/veiculos/cadastrar"
                class="btn btn-primary"
            >
                 Novo Veículo
            </a>

        </div>

        <br>


        <% if (veiculos.length === 0) { %>

            <p>
                Nenhum veículo cadastrado.
            </p>

        <% } else { %>


            <% veiculos.forEach(veiculo => { %>

                <div class="detalhe">

                    <strong>Marca</strong>

                    <span>
                        <%= veiculo.marca %>
                    </span>


                    <br>


                    <strong>Modelo</strong>

                    <span>
                        <%= veiculo.modelo %>
                    </span>


                    <br>


                    <strong>Placa</strong>

                    <span>
                        <%= veiculo.placa %>
                    </span>


                    <br>


                    <strong>Ano</strong>

                    <span>
                        <%= veiculo.ano || "Não informado" %>
                    </span>


                    <div class="botoes">

                        <a
                            href="/veiculos/<%= veiculo.id %>"
                            class="btn btn-primary"
                        >
                            Detalhes
                        </a>


                        <a
                            href="/veiculos/<%= veiculo.id %>/editar"
                            class="btn btn-warning"
                        >
                             Editar
                        </a>


                        <form
                            action="/veiculos/<%= veiculo.id %>?_method=DELETE"
                            method="POST"
                            style="display: inline;"
                            onsubmit="return confirm('Tem certeza que deseja excluir este veículo?');"
                        >

                            <button
                                type="submit"
                                class="btn btn-danger"
                            >
                                 Excluir
                            </button>

                        </form>

                    </div>

                </div>

            <% }) %>


        <% } %>

    </div>

</main>

</body>

</html>