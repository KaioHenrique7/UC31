<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Veículos - Oficina</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f4f6f9;
            color: #222;
        }

        header {
            background: #1769e0;
            color: white;
            padding: 25px;
            text-align: center;
        }

        header h1 {
            margin: 0 0 8px;
        }

        .container {
            width: 90%;
            max-width: 1100px;
            margin: 35px auto;
        }

        .topo {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 25px;
        }

        .topo h2 {
            margin: 0;
        }

        .btn {
            text-decoration: none;
            border: none;
            border-radius: 8px;
            padding: 11px 18px;
            cursor: pointer;
            font-size: 15px;
            display: inline-block;
        }

        .btn-principal {
            background: #1769e0;
            color: white;
        }

        .btn-principal:hover {
            background: #0d55bd;
        }

        .btn-voltar {
            background: #555;
            color: white;
        }

        .tabela-container {
            background: white;
            border-radius: 12px;
            box-shadow: 0 3px 12px rgba(0,0,0,0.08);
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th {
            background: #1769e0;
            color: white;
            padding: 15px;
            text-align: left;
        }

        td {
            padding: 15px;
            border-bottom: 1px solid #eee;
        }

        tr:hover {
            background: #f7f9fc;
        }

        .acoes {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }

        .btn-detalhes {
            background: #17a2b8;
            color: white;
        }

        .btn-editar {
            background: #f0ad00;
            color: white;
        }

        .vazio {
            text-align: center;
            padding: 40px;
            color: #777;
        }

        footer {
            text-align: center;
            padding: 25px;
            color: #777;
        }
    </style>
</head>

<body>

<header>
    <h1> Sistema da Oficina</h1>
    <p>Gerenciamento de veículos</p>
</header>

<main class="container">

    <div class="topo">
        <h2>Veículos cadastrados</h2>

        <div>
            <a href="/" class="btn btn-voltar">← Início</a>
            <a href="/veiculos/novo" class="btn btn-principal">
                + Novo veículo
            </a>
        </div>
    </div>

    <% if (veiculos.length === 0) { %>

        <div class="tabela-container">
            <div class="vazio">
                <h3>🚘 Nenhum veículo cadastrado</h3>
                <p>Comece cadastrando o primeiro veículo.</p>

                <a href="/veiculos/novo" class="btn btn-principal">
                    Cadastrar veículo
                </a>
            </div>
        </div>

    <% } else { %>

        <div class="tabela-container">

            <table>
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Marca</th>
                        <th>Modelo</th>
                        <th>Placa</th>
                        <th>Ações</th>
                    </tr>
                </thead>

                <tbody>

                    <% veiculos.forEach(veiculo => { %>

                        <tr>
                            <td><%= veiculo.id %></td>

                            <td>
                                <strong><%= veiculo.marca %></strong>
                            </td>

                            <td>
                                <%= veiculo.modelo %>
                            </td>

                            <td>
                                <strong><%= veiculo.placa %></strong>
                            </td>

                            <td>
                                <div class="acoes">

                                    <a
                                        href="/veiculos/<%= veiculo.id %>"
                                        class="btn btn-detalhes">
                                        Detalhes
                                    </a>

                                    <a
                                        href="/veiculos/<%= veiculo.id %>/editar"
                                        class="btn btn-editar">
                                        Editar
                                    </a>

                                </div>
                            </td>
                        </tr>

                    <% }) %>

                </tbody>
            </table>

        </div>

    <% } %>

</main>

<footer>
    Sistema de gerenciamento de oficina
</footer>

</body>
</html>